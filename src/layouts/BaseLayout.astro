---
import { copy, legal, links, localePath, locales, siteUrl, type Locale } from '../data/site';
import portrait from '../../assets/unnamed.jpg';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  path?: string;
  type?: 'WebPage' | 'ProfilePage' | 'CollectionPage' | 'Article';
}

const { locale = 'en', title, description, path = '', type = 'WebPage' } = Astro.props;
const text = copy[locale];
const canonical = `${siteUrl}${localePath(locale, path)}`;
const portraitUrl = new URL(portrait.src, Astro.site ?? siteUrl).href;
const alternateLinks = locales.map((item) => ({ locale: item, href: `${siteUrl}${localePath(item, path)}` }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': `${siteUrl}/#person`, name: 'Valentyn Yakovliev', alternateName: 'VaiYav', jobTitle: 'Product Engineer & AI Systems Builder', url: siteUrl, image: portraitUrl, sameAs: [links.linkedin, links.github], email: legal.email, telephone: legal.phoneHref, worksFor: { '@id': `${siteUrl}/#organization` }, knowsAbout: ['Product Engineering', 'AI Agents', 'RAG', 'TypeScript', 'Vue.js', 'React', 'Node.js', 'NestJS', 'Python', 'FastAPI', 'Product Strategy', 'Technical Leadership'] },
    { '@type': 'Organization', '@id': `${siteUrl}/#organization`, name: legal.legalName, legalName: legal.legalName, alternateName: legal.legalNameLatin, url: siteUrl, logo: `${siteUrl}/favicon.svg`, image: portraitUrl, email: legal.email, telephone: legal.phoneHref, taxID: legal.taxId, identifier: [{ '@type': 'PropertyValue', propertyID: 'EDR', name: legal.edrLabel, value: legal.edrNumber }], foundingDate: legal.edrEntryDate, address: { '@type': 'PostalAddress', streetAddress: legal.streetAddress, addressLocality: legal.addressLocality, addressRegion: legal.addressRegion, postalCode: legal.postalCode, addressCountry: legal.addressCountry }, contactPoint: [{ '@type': 'ContactPoint', contactType: 'customer service', email: legal.email, telephone: legal.phoneHref, availableLanguage: ['uk', 'en', 'ru'], areaServed: 'Worldwide' }], founder: { '@id': `${siteUrl}/#person` } },
    { '@type': type, '@id': `${canonical}#page`, url: canonical, name: title ?? text.title, description: description ?? text.description, inLanguage: locale, isPartOf: { '@id': `${siteUrl}/#website` }, about: { '@id': `${siteUrl}/#person` } },
    { '@type': 'WebSite', '@id': `${siteUrl}/#website`, url: siteUrl, name: 'Valentyn Yakovliev', inLanguage: locale, publisher: { '@id': `${siteUrl}/#organization` } },
  ],
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? text.title}</title>
    <meta name="description" content={description ?? text.description} />
    <meta name="author" content="Valentyn Yakovliev" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map(({ locale: alternate, href }) => <link rel="alternate" hreflang={alternate} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${localePath('en', path)}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <ClientRouter />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title ?? text.title} />
    <meta property="og:description" content={description ?? text.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Valentyn Yakovliev" />
    <meta property="og:image" content={portraitUrl} />
    <meta property="og:image:alt" content="Portrait of Valentyn Yakovliev" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <slot />
    <script>
      const initReveal = () => {
        const elements = document.querySelectorAll('[data-reveal]');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) {
          elements.forEach((element) => element.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });
        elements.forEach((element) => observer.observe(element));
      };
      document.addEventListener('astro:page-load', initReveal);
      initReveal();

      const pressSelector = '.primary-button, .light-button, .email-link, .topnav a, .language-switcher a, .footer a';
      const replayPress = (element: HTMLElement) => {
        element.classList.remove('is-pressed');
        void element.offsetWidth;
        element.classList.add('is-pressed');
        window.setTimeout(() => element.classList.remove('is-pressed'), 560);
      };
      document.addEventListener('pointerdown', (event) => {
        if (!(event.target instanceof Element)) return;
        const element = event.target.closest(pressSelector);
        if (element) replayPress(element as HTMLElement);
      }, { passive: true });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        if (!(event.target instanceof Element)) return;
        const element = event.target.closest(pressSelector);
        if (element) replayPress(element as HTMLElement);
      });
    </script>
  </body>
</html>
