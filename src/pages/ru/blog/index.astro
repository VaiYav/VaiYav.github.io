---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { copy, links } from '../../../data/site';
const text = copy.ru;
---
<BaseLayout locale="ru" title="Заметки — Валентин Яковлев" description="Будущие заметки о продуктовой инженерии, AI-системах и запуске продуктов." path="blog" type="CollectionPage"><div class="site-shell"><a class="skip-link" href="#content">Перейти к содержанию</a><SiteHeader locale="ru" path="blog" /><main id="content"><section class="frame hero"><p class="eyebrow">Редакционный индекс · скоро</p><h1>Заметки на границе продукта.</h1><p class="hero-copy">База знаний о создании продуктов, AI-систем и решениях, которые делают релиз реальным. Первые материалы проходят исследование.</p><div class="hero-actions"><a class="primary-button" href={links.email}>Предложить тему</a></div></section><section class="frame section"><h2>Темы</h2><p class="section-intro"><a href="/ru/blog/topics/">Открыть редакционные темы →</a></p></section></main><footer class="frame footer"><span>{text.footer}</span><span><a href={links.linkedin}>LinkedIn ↗</a> · <a href={links.github}>GitHub ↗</a></span></footer></div></BaseLayout>
