---
import { homeCopy } from '../data/home';
import { links, localePath, locales, type Locale } from '../data/site';
interface Props { locale?: Locale; path?: string }
const { locale = 'en', path = '' } = Astro.props;
const nav = homeCopy[locale].nav;
const home = localePath(locale);
const items = [
  { label: nav.products, href: `${home}#products` },
  { label: nav.about, href: `${home}#about` },
  { label: nav.rescue, href: `${home}#rescue` },
  { label: nav.notes, href: localePath(locale, 'blog'), current: path.startsWith('blog') },
];
---
<header class="topbar frame">
  <a class="wordmark" href={home}>Valentyn Yakovliev</a>
  <nav class="topnav" aria-label={nav.label}>
    {items.map((item) => <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <a class="topbar-cv" href={links.cv}>{nav.cv}</a>
  <div class="language-switcher" role="group" aria-label={nav.language}>
    {locales.map((item) => <a class:list={{ active: locale === item }} href={localePath(item, path)} lang={item} hreflang={item}>{item.toUpperCase()}</a>)}
  </div>
</header>
