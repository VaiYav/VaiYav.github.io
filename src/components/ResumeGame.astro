---
import { gameObjects, objectsByRoom, roomOrder, rooms } from '../data/game/content';
import { links } from '../data/site';
import { WORLD } from '../game/engine/viewport';
---
<section class="frame section game-section" id="play" lang="en" data-game data-state="idle" aria-labelledby="game-title">
  {/* The arcade window in the page hero carries the visible title; this one names the section for assistive tech. */}
  <h2 id="game-title" class="game-heading">Interactive résumé: Neon HQ</h2>

  <div class="game-stage" data-game-stage tabindex="-1" role="group" aria-label="Résumé game">
    <canvas data-game-canvas width={WORLD.width} height={WORLD.height} aria-hidden="true"></canvas>
    <div class="game-cover" data-game-cover>
      <canvas class="game-title-face" data-game-title-face width="48" height="48" aria-hidden="true"></canvas>
      <div class="game-menu">
        <p class="game-title">Neon HQ</p>
        <p class="game-subtitle" data-game-subtitle>A playable résumé</p>
        <div class="game-menu-actions">
          <button type="button" class="light-button" data-game-start>Start</button>
          <a class="game-skip" href={links.cv}>Recruiter CV</a>
        </div>
        <p class="game-keys">WASD or arrows: walk · E: open · Esc: menu · or just tap</p>
      </div>
    </div>
    <div class="game-tools" data-game-layer>
      <button type="button" data-game-menu>Menu</button>
      <button type="button" data-game-music aria-pressed="false">♪ Music</button>
      <button type="button" data-game-fullscreen hidden>Full screen</button>
    </div>
    <p class="game-hud" data-game-hud><span data-game-count>0</span> / {gameObjects.length}<span class="game-hud-word"> found</span></p>
    <p class="game-hint" data-game-hint hidden></p>
    <div class="game-dialog" data-game-dialog data-game-layer role="region" aria-label="Résumé entry" hidden>
      <canvas class="game-portrait" data-game-portrait width="48" height="48" aria-hidden="true"></canvas>
      <div class="game-dialog-text">
        <p class="game-dialog-room" data-game-dialog-room></p>
        <h3 data-game-dialog-title></h3>
        <p data-game-dialog-body></p>
        <p class="game-links" data-game-dialog-links></p>
      </div>
      <button type="button" class="game-dialog-close" data-game-dialog-close>Close <kbd>E</kbd></button>
    </div>
    <ul class="game-objects" data-game-objects data-game-layer aria-label="Open an object directly">
      {gameObjects.map((object) => <li><button type="button" data-open-object={object.id}>{object.title}</button></li>)}
    </ul>
    <div data-game-finale hidden>
      <span data-title>All {gameObjects.length} found. That is the whole résumé.</span>
      <span data-body>Thanks for walking through it. If the work looks like a fit, the recruiter CV has everything on one page, and I answer email quickly.</span>
      <a href={links.cv}>Open the recruiter CV</a>
      <a href={links.email}>Email me</a>
    </div>
    <p class="game-status" data-game-status role="status"></p>
    <p class="game-error" data-game-error role="alert" hidden>The game could not start in this browser. The same content is listed below.</p>
  </div>

  <div class="game-text">
    <h3>Everything in the office, as text</h3>
    <div class="game-rooms">
      {roomOrder.map((room) => (
        <section aria-labelledby={`room-${room}`}>
          <p class="case-tag">{rooms[room].blurb}</p>
          <h4 id={`room-${room}`}>{rooms[room].title}</h4>
          <dl>
            {objectsByRoom(room).map((object) => (
              <div data-object={object.id}>
                <dt data-title>{object.title}</dt>
                <dd data-body>
                  {object.body}
                  {object.links && (
                    <span class="game-links">
                      {object.links.map((link) => <a href={link.href}>{link.label}</a>)}
                    </span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </div>
</section>

<script>
  import { mountShell } from '../game/dom/shell';

  let unmount: (() => void) | null = null;

  const teardown = () => {
    unmount?.();
    unmount = null;
  };
  const setup = () => {
    const root = document.querySelector<HTMLElement>('[data-game]');
    if (root && root.dataset.bound !== 'true') unmount = mountShell(root);
  };

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', teardown);
  setup();
</script>

<style>
  .game-section { border-top: var(--line); background: var(--white); }
  .game-stage { position: relative; display: none; place-items: center; min-height: 240px; margin-bottom: 42px; border: var(--line); background: #1a0b2e; box-shadow: var(--shadow-sm); overflow: hidden; }
  /* Shown only once the script has bound the section, so no-JS visitors never see a dead Start button. */
  [data-bound='true'] .game-stage { display: grid; }
  .game-stage canvas { display: block; max-width: 100%; height: auto; image-rendering: pixelated; cursor: pointer; touch-action: manipulation; }
  .game-cover { position: absolute; inset: 0; z-index: 2; display: flex; align-items: center; justify-content: center; gap: 20px 28px; padding: 20px; overflow: auto; background: rgba(13, 5, 24, .9); color: #fdf6ff; }
  .game-title-face { flex: none; width: 144px; height: 144px; image-rendering: pixelated; background: #5a1a7a; border: 3px solid #01e7f0; box-shadow: 6px 6px 0 #ff2e88; }
  .game-menu { display: grid; gap: 10px; justify-items: start; }
  .game-title { margin: 0; color: #fdf6ff; font-family: var(--display); font-size: clamp(2rem, 6vw, 3.4rem); font-weight: 800; line-height: 1; letter-spacing: -.03em; text-shadow: -3px 0 0 #01e7f0, 4px 3px 0 #ff2e88; }
  .game-subtitle { margin: 0; color: #fff35c; font-size: .85rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .game-menu-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: 6px; }
  .game-cover button { font: inherit; font-weight: 700; cursor: pointer; }
  .game-skip { color: #fdf6ff; font-weight: 700; text-underline-offset: 4px; }
  .game-keys { margin: 4px 0 0; color: #c2a8d8; font-size: .78rem; }
  [data-state='running'] .game-cover { display: none; }
  .game-tools { position: absolute; top: 10px; right: 10px; z-index: 1; display: none; gap: 6px; }
  [data-state='running'] .game-tools { display: flex; }
  .game-tools button { padding: 6px 10px; border: 2px solid #fdf6ff; background: rgba(13, 5, 24, .82); color: #fdf6ff; font: inherit; font-size: .8rem; font-weight: 700; cursor: pointer; }
  .game-tools button[hidden] { display: none; }
  .game-tools button:hover, .game-tools button:focus-visible, .game-tools button[aria-pressed='true'] { background: #fff35c; border-color: #fff35c; color: #0d0518; }
  @media (max-width: 520px) { .game-title-face { width: 72px; height: 72px; } .game-keys { display: none; } .game-tools button { padding: 5px 7px; font-size: .72rem; } .game-hud-word { display: none; } .game-objects { top: 46px; } [data-state='running'] .game-stage { padding-top: 46px; } }
  .game-hud, .game-hint { position: absolute; margin: 0; padding: 6px 10px; border: 2px solid #fdf6ff; background: rgba(13, 5, 24, .82); color: #fdf6ff; font-size: .8rem; font-weight: 700; display: none; }
  .game-hud { top: 10px; left: 10px; }
  .game-hint { left: 50%; bottom: 10px; max-width: calc(100% - 20px); transform: translateX(-50%); border-color: #fff35c; color: #fff35c; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  [data-state='running'] .game-hud, [data-state='running'] .game-hint:not([hidden]) { display: block; }
  .game-dialog { position: absolute; z-index: 2; left: 8px; right: 8px; bottom: 8px; max-height: calc(100% - 16px); overflow: auto; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px 16px; align-items: start; padding: 14px; border: 3px solid #fdf6ff; background: #0d0518; color: #fdf6ff; box-shadow: 6px 6px 0 #ff2e88; }
  .game-dialog[hidden] { display: none; }
  .game-portrait { width: 96px; height: 96px; image-rendering: pixelated; background: #5a1a7a; border: 2px solid #01e7f0; }
  .game-dialog-room { margin: 0 0 4px; color: #01e7f0; font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .game-dialog h3 { margin: 0 0 8px; color: #fff35c; font-size: 1.15rem; line-height: 1.2; }
  .game-dialog p { margin: 0; font-size: .95rem; line-height: 1.5; }
  .game-dialog .game-links { margin-top: 10px; }
  .game-dialog .game-links[hidden] { display: none; }
  .game-dialog .game-links a { color: #fff35c; }
  .game-dialog-close { grid-column: 1 / -1; justify-self: end; padding: 6px 12px; border: 2px solid #fdf6ff; background: #fdf6ff; color: #0d0518; font: inherit; font-size: .85rem; font-weight: 700; cursor: pointer; }
  .game-dialog-close kbd { margin-left: 6px; padding: 0 5px; border: 1px solid #0d0518; font: inherit; font-size: .75rem; }
  .game-dialog :focus-visible, .game-objects :focus-visible { outline: 3px solid #fff35c; outline-offset: 2px; }
  /* Keyboard and screen-reader shortcut to every object; a button shows itself while it has focus. */
  .game-objects { position: absolute; top: 46px; left: 10px; display: none; margin: 0; padding: 0; list-style: none; }
  [data-state='running'] .game-objects { display: block; }
  .game-objects button { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 2px solid #fff35c; background: #0d0518; color: #fff35c; font: inherit; font-size: .8rem; font-weight: 700; }
  .game-objects button:focus-visible { width: auto; height: auto; margin: 0; padding: 6px 10px; clip-path: none; }
  @media (max-width: 520px) { .game-portrait { width: 64px; height: 64px; } .game-dialog { padding: 10px; gap: 8px 10px; } .game-dialog p { font-size: .88rem; } }
  .game-stage:fullscreen { width: 100vw; height: 100vh; margin: 0; border: 0; }
  .game-stage:focus-visible { outline: 3px solid var(--yellow); outline-offset: 3px; }
  .game-heading, .game-status { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .game-error { position: absolute; z-index: 3; left: 0; right: 0; bottom: 0; margin: 0; padding: 12px 16px; background: var(--yellow); border-top: var(--line-sm); font-weight: 600; }
  .game-text h3 { margin-bottom: 24px; }
  .game-rooms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; border-top: var(--line-sm); border-left: var(--line-sm); }
  .game-rooms section { padding: 22px; border-right: var(--line-sm); border-bottom: var(--line-sm); }
  .game-rooms h4 { margin: 0 0 14px; font-family: var(--display); font-size: 1.4rem; letter-spacing: -.04em; }
  .game-rooms dl { display: grid; gap: 14px; margin: 0; }
  .game-rooms dt { font-weight: 700; }
  .game-rooms dd { margin: 4px 0 0; color: var(--muted); font-size: .92rem; }
  .game-links { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 6px; }
  .game-links a { color: var(--ink); font-weight: 700; text-underline-offset: 4px; }
  @media (max-width: 900px) { .game-rooms { grid-template-columns: 1fr; } }
</style>
