---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import HomeHero from './HomeHero.astro';
import SoloProducts from './SoloProducts.astro';
import { Image } from 'astro:assets';
import portrait from '../../assets/unnamed.jpg';
import { homeCopy } from '../data/home';
import { copy, links, type Locale } from '../data/site';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const text = copy[locale];
const home = homeCopy[locale];
const answers = [
  { title: text.whatTitle, body: text.whatText },
  { title: text.whoTitle, body: text.whoText },
  { title: text.experienceTitle, body: text.experienceText },
  { title: text.stackTitle, body: text.stackText },
  { title: text.availabilityTitle, body: text.availabilityText },
];
---
<BaseLayout locale={locale} type="ProfilePage">
  <div class="site-shell">
    <a class="skip-link" href="#content">{home.skip}</a>
    <SiteHeader locale={locale} />
    <main id="content">
      <HomeHero locale={locale} />
      <section class="facts" aria-label={home.factsLabel}>
        <ul class="frame facts-list">
          {home.facts.map((fact) => <li><strong>{fact.lead}</strong><span>{fact.text}</span></li>)}
        </ul>
      </section>
      <SoloProducts locale={locale} />
      <section class="frame section about-section" id="about" data-reveal>
        <div class="section-header">
          <div><p class="section-index">{home.about.index}</p><h2>{home.about.title}</h2></div>
          <p class="section-intro">{home.about.intro}</p>
        </div>
        <div class="about-grid">
          <figure class="portrait-block about-portrait">
            <div class="portrait-frame"><Image src={portrait} alt={home.about.portraitAlt} width={796} height={1024} loading="lazy" /></div>
            <figcaption class="about-caption">{home.about.caption}</figcaption>
          </figure>
          <dl class="about-list">
            {answers.map((answer) => <div><dt>{answer.title}</dt><dd>{answer.body}</dd></div>)}
          </dl>
        </div>
      </section>
      <section class="method-section" id="rescue" data-reveal>
        <div class="frame section">
          <div class="section-header">
            <div><p class="section-index">{home.rescue.index}</p><h2>{text.methodTitle}</h2></div>
            <p class="section-intro method-intro">{text.productText}</p>
          </div>
          <ol class="method-grid rescue-steps">
            {home.rescue.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
          </ol>
          <a class="light-button" href={links.telegram}>{text.secondary}</a>
        </div>
      </section>
      <section class="frame contact-section" id="contact" data-reveal>
        <div class="contact-frame">
          <p class="eyebrow">{home.contactEyebrow}</p>
          <h2>{text.contactTitle}</h2>
          <p>{text.contactText}</p>
          <div class="hero-actions"><a class="primary-button" href={links.cv}>{text.primary}</a><a class="email-link" href={links.email}>{text.email}</a></div>
        </div>
      </section>
    </main>
    <SiteFooter locale={locale} />
  </div>
</BaseLayout>
