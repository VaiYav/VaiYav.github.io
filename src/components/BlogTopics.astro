---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import { copy, links, type Locale } from '../data/site';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const text = copy[locale];
const topics = locale === 'uk'
  ? ['AI-системи в production', 'Product rescue та продуктові рішення', 'Full-stack продуктова інженерія', 'SEO, AEO і GEO для білдерів']
  : locale === 'ru'
    ? ['AI-системы в production', 'Product rescue и продуктовые решения', 'Full-stack продуктовая инженерия', 'SEO, AEO и GEO для билдеров']
    : ['AI systems in production', 'Product rescue and product decisions', 'Full-stack product engineering', 'SEO, AEO and GEO for builders'];
---
<BaseLayout locale={locale} title={`${locale === 'en' ? 'Topics' : locale === 'uk' ? 'Теми' : 'Темы'} — Valentyn Yakovliev`} description={text.description} path="blog/topics" type="CollectionPage">
  <div class="site-shell"><a class="skip-link" href="#content">Skip to content</a><SiteHeader locale={locale} path="blog/topics" /><main id="content"><section class="frame hero"><p class="eyebrow">Editorial taxonomy</p><h1>{locale === 'en' ? 'Topic briefs.' : locale === 'uk' ? 'Редакційні теми.' : 'Редакционные темы.'}</h1><p class="hero-copy">{locale === 'en' ? 'Each topic becomes indexable only when it has original research, examples and a clear reader question.' : locale === 'uk' ? 'Кожна тема стане індексованою лише після підготовки оригінального дослідження, прикладів і чіткого питання читача.' : 'Каждая тема станет индексируемой только после подготовки оригинального исследования, примеров и чёткого вопроса читателя.'}</p></section><section class="frame section"><div class="answer-grid">{topics.map((topic) => <article><h2>{topic}</h2><p>{locale === 'en' ? 'Editorial brief prepared; publication is pending evidence.' : locale === 'uk' ? 'Редакційний brief підготовлено; публікація очікує на докази.' : 'Редакционный brief подготовлен; публикация ждёт доказательной базы.'}</p></article>)}</div><p class="section-intro"><a href={locale === 'en' ? '/blog/' : `/${locale}/blog/`}>{locale === 'en' ? 'Back to notes →' : locale === 'uk' ? 'До нотаток →' : 'К заметкам →'}</a></p></section></main><footer class="frame footer"><span>{text.footer}</span><span><a href={links.linkedin}>LinkedIn ↗</a> · <a href={links.github}>GitHub ↗</a></span></footer></div>
</BaseLayout>
